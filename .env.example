# Alamat wajik-anime-api.
# Default "/api" -> diteruskan oleh Vite dev server ke API_PROXY_TARGET.
# Kalau API kamu udah di-deploy (misal di Vercel), isi URL lengkapnya:
# VITE_API_URL=https://wajik-anime-api-kamu.vercel.app
VITE_API_URL=/api

# Target proxy waktu `npm run dev` (alamat wajik-anime-api yang jalan di lokal)
API_PROXY_TARGET=http://localhost:3001

# Alamat wajik-anime-api yang dipakai browser.
# Default "/api" -> diteruskan oleh Vite dev server ke API_PROXY_TARGET (cuma buat `npm run dev`).
# Di produksi WAJIB alamat lengkap, misal:
# VITE_API_URL=https://wajik-anime-api-kamu.vercel.app
VITE_API_URL=/api

# Target proxy waktu `npm run dev` (alamat wajik-anime-api yang jalan di lokal)
API_PROXY_TARGET=http://localhost:3001

# ---- SEO (isi waktu deploy) ----
# Alamat lengkap web kamu, tanpa "/" di akhir. Dipakai buat canonical URL,
# og:url, gambar preview, dan sitemap.xml.
# VITE_SITE_URL=https://animeku.vercel.app

# Alamat wajik-anime-api yang bisa diakses dari server (waktu build & di fungsi
# api/meta.ts). Kalau VITE_API_URL udah alamat lengkap, ini boleh dikosongin.
# API_URL=https://wajik-anime-api-kamu.vercel.app

# ---- Server VPS (npm start) ----
# PORT=4173
# ADMIN_PASSWORD=ganti-pakai-password-panjang
# TMDB_API_KEY=
# OPS_TOKEN=   # panel kontrol VPS lewat HTTPS (bikin: openssl rand -hex 32)
